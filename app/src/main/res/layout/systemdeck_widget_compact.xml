<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/systemdeck_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="13dp"
    android:paddingTop="7dp"
    android:paddingEnd="13dp"
    android:paddingBottom="7dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:text="SD"
        android:textColor="#F5F5F7"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_cpu"
        style="@style/SystemDeckWidgetMetricCompact" />

    <TextView
        android:id="@+id/widget_memory"
        style="@style/SystemDeckWidgetMetricCompact" />

    <TextView
        android:id="@+id/widget_battery"
        style="@style/SystemDeckWidgetMetricCompact" />

    <TextView
        android:id="@+id/widget_thermal"
        style="@style/SystemDeckWidgetMetricCompact" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:textColor="#636366"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="OPEN"
        android:textColor="#8E8E93"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
